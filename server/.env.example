# ── Server ──────────────────────────────────────────────────────────────
# Port the Express API listens on (Render injects its own PORT env var)
PORT=5000

# MongoDB connection string (MongoDB Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=shohojog

# Secret used by BetterAuth to sign sessions/cookies (openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Public URL of THIS server (used as BetterAuth baseURL + JWT issuer/audience)
SERVER_URL=http://localhost:5000

# URL of the Next.js client (CORS + trusted origin + OAuth redirect target)
CLIENT_URL=http://localhost:3000

# Google OAuth credentials (Google Cloud Console → Credentials → OAuth client)
# Leave empty to run without Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
